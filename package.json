{
  "name": "build-echo",
  "version": "1.0.0",
  "private": true,
  "description": "Production source and release tooling for the Build Echo Minecraft Bedrock add-on.",
  "type": "module",
  "author": "quillphen",
  "license": "MIT",
  "scripts": {
    "assets": "node tools/generate-assets.mjs",
    "check": "tsc -p jsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "benchmark": "node tools/benchmark.mjs",
    "validate": "node tools/validate.mjs",
    "build": "node tools/build.mjs",
    "release": "npm run assets && npm run check && npm test && npm run validate && npm run build"
  },
  "devDependencies": {
    "@minecraft/common": "1.2.0",
    "@minecraft/server": "2.8.0",
    "@minecraft/server-ui": "2.1.0",
    "@minecraft/vanilla-data": "1.26.30",
    "fflate": "0.8.2",
    "typescript": "5.9.2"
  }
}
